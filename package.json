{
  "name": "uni-flexible-draw",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@9.0.0",
  "description": "基于 Vue3 + AntV X6 的通用绘图组件库",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/index.ts",
      "default": "./lib/index.ts"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "imports": {
    "#/*": "./lib/*",
    "@uni-draw/*": "lib/*"
  },
  "scripts": {
    "dev": "vite",
    "dev:vue": "vite --config examples/vue/vite.config.ts examples/vue",
    "dev:react": "pnpm --dir examples/react dev",
    "dev:server": "node server/index.mjs",
    "dev:assets-api": "node server/index.mjs",
    "crawl:assets": "python scripts/crawl_scidraw_assets.py",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx,.vue",
    "lint:fix": "eslint . --ext .ts,.tsx,.vue --fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@antv/x6": "^2.18.1",
    "@antv/x6-plugin-history": "^2.1.5",
    "@antv/x6-plugin-selection": "^2.2.2",
    "@antv/x6-plugin-transform": "^2.1.8",
    "@vicons/ionicons5": "^0.12.0",
    "lucide-vue-next": "^1.0.0",
    "roughjs": "^4.6.6",
    "vue-json-pretty": "^2.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.21.0",
    "@antv/x6-plugin-export": "^2.1.6",
    "@antv/x6-plugin-minimap": "^2.0.7",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.4.0",
    "eslint-plugin-format": "^2.0.1",
    "happy-dom": "^20.10.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.12",
    "vitest": "^2.1.9",
    "vue": "^3.4.27",
    "vue-tsc": "^2.0.0"
  }
}
